{
  "manifest_version": 3,
  "name": "Photos Storage Cleaner",
  "version": "0.1.0",
  "description": "Find duplicate and similar Google Photos with on-device AI and free up Google storage. Photos never leave your device.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Photos Storage Cleaner"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "downloads",
    "offscreen"
  ],
  "host_permissions": [
    "https://photos.google.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
